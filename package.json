{
  "name": "ethioexplore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:all": "concurrently \"npm run server:dev\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"yellow,cyan\"",
    "start:all": "concurrently \"npm run server\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"yellow,cyan\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "db:init": "node server/scripts/initDb.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mysql2": "^3.12.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "vite": "^6.1.1"
  }
}
